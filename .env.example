# Copy to .env. Do not put account passwords in chat or commit this file.
# Leave SMTP_HOST blank until you connect Gmail; messages wait for email setup.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Public application address used in reset links if hosted later.
RENEWSURE_BASE_URL=http://127.0.0.1:8766
